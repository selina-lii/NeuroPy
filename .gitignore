# Images
images/**/*test*/
images/**/*tmp*/
images/tmp/

# Local data cache (CCG computation results, etc.)
data/*
# Allow traversing subdirectories so JSON whitelist works
!data/*/
!data/*/*/
# Track JSON files (selections, configs, etc.)
!data/**/*.json
# But never track history snapshots (even though they are JSON)
data/selections/.history/
# But ignore everything under ccg/ and jitter/ (hkl + meta.json)
data/ccg/
data/jitter/
# Ignore local custom CCG binary caches; keep JSON suggestion lists
data/custom_ccg/**/*.npz



data/images/random/
